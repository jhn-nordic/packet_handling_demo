# Copy to .env and fill in. scripts/*.sh and docker compose read this file.
# .env is git-ignored; never commit it.

# ── nRF Cloud ─────────────────────────────────────────────────────
# nrfcloud.com → User Account → API key (Admin/Owner role on the team)
NRFCLOUD_API_KEY=

# Filled in by scripts/fly-deploy.sh or `scripts/mrs.sh team` if left empty
NRFCLOUD_TEAM_ID=

# Shared between PocketBase and the MRS destination. Generated by
# scripts/fly-deploy.sh / scripts/mrs.sh if left empty.
NRFCLOUD_WEBHOOK_TOKEN=
NRFCLOUD_WEBHOOK_SECRET=

# ── Fly.io ────────────────────────────────────────────────────────
# Globally unique app name → https://<FLY_APP>.fly.dev
FLY_APP=
# https://fly.io/docs/reference/regions/ (arn = Stockholm, ams, fra, iad, sjc, nrt, …)
FLY_REGION=arn
# Fly organization slug (default: personal)
FLY_ORG=

# ── PocketBase admin (https://<host>/_/) ──────────────────────────
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────
# Public URL when not on Fly (e.g. a tunnel or your own server).
# Overrides https://$FLY_APP.fly.dev in the scripts.
PUBLIC_URL=
# Name of the MRS destination (default: smartparcel-<FLY_APP or "local">)
MRS_DESTINATION_NAME=
# Days to keep raw_messages (0 = forever)
RAW_RETENTION_DAYS=7
